{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "Notification": [{
      "matcher": "",
      "hooks": [
        {"type": "command", "command": "[ -n \"$ZELLIJ_PANE_ID\" ] && zellij pipe --name \"zellij-attention::waiting::$ZELLIJ_PANE_ID\" || true"},
        {"type": "command", "command": "notify-send \"Claude Code: ${ZELLIJ_SESSION_NAME:-$(basename $PWD)}\" 'Waiting for input' -i dialog-information"}
      ]
    }],
    "Stop": [{
      "hooks": [
        {"type": "command", "command": "[ -n \"$ZELLIJ_PANE_ID\" ] && zellij pipe --name \"zellij-attention::completed::$ZELLIJ_PANE_ID\" || true"},
        {"type": "command", "command": "notify-send \"Claude Code: ${ZELLIJ_SESSION_NAME:-$(basename $PWD)}\" 'Task complete' -i dialog-information"}
      ]
    }]
  },
  "permissions": {
    "allow": [
      "Bash(journalctl:*)",
      "Bash(systemctl:*)",
      "Bash(systemd-analyze:*)",
      "Bash(sudo apt install:*)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [],
    "ask": []
  },
  "statusLine": {
    "type": "command",
    "command": "/home/jreuben1/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "session-report@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "claude-api@anthropic-agent-skills": true,
    "document-skills@anthropic-agent-skills": false,
    "example-skills@anthropic-agent-skills": false,
    "typescript-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "huggingface-skills@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "cc-marketplace": {
      "source": {
        "source": "github",
        "repo": "ananddtyagi/cc-marketplace"
      }
    },
    "claude-night-market": {
      "source": {
        "source": "github",
        "repo": "athola/claude-night-market"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "advisorModel": "opus",
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "vim",
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/jreuben1"
      ]
    },
    "git": {
      "command": "uvx",
      "args": [
        "mcp-server-git"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "hyprmcp": {
      "command": "/home/jreuben1/.local/share/hyprmcp/run-hyprmcp.sh",
      "args": [],
      "env": {
        "PYTHONPATH": "/home/jreuben1/.local/share/hyprmcp"
      }
    }
  },
  "disableMcpServers": [
    "git",
    "memory",
    "playwright",
    "chrome-devtools"
  ]
}
