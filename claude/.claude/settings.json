{
  "permissions": {
    "allow": [
      "Bash(journalctl:*)",
      "Bash(systemctl:*)",
      "Bash(systemd-analyze:*)",
      "Bash(sudo apt install:*)"
    ],
    "deny": [],
    "ask": []
  },
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/jreuben1"
      ]
    },
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git", "--repository", "/home/jreuben1"]
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "context7-mcp-server"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    }
  },
  "disableMcpServers": [
    "memory",
    "playwright",
    "chrome-devtools"
  ]
}
