{
  "skillListingBudgetFraction": 0.02,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git remote*)",
      "Bash(git submodule*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git clone*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git stash*)",
      "Bash(gh *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(ll *)",
      "Bash(eza *)",
      "Bash(tree *)",
      "Bash(cat *)",
      "Bash(bat *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(which *)",
      "Bash(man *)",
      "Bash(uname *)",
      "Bash(id *)",
      "Bash(ps *)",
      "Bash(ip *)",
      "Bash(dmesg *)",
      "Bash(lsmod*)",
      "Bash(dpkg*)",
      "Bash(make *)",
      "Bash(clang *)",
      "Bash(gcc *)",
      "Bash(bpftool *)",
      "Bash(sudo bpftool *)",
      "Bash(llvm-strip *)",
      "Bash(llvm-objdump *)",
      "Bash(readelf *)",
      "Bash(nm *)",
      "Bash(cargo build*)",
      "Bash(cargo test*)",
      "Bash(cargo run*)",
      "Bash(cargo check*)",
      "Bash(cargo add*)",
      "Bash(cargo install*)",
      "Bash(rustup *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(uv *)",
      "Bash(pip list*)",
      "Bash(pip show*)",
      "Bash(npm install*)",
      "Bash(npm list*)",
      "Bash(pnpm install*)",
      "Bash(pnpm list*)",
      "Bash(kubectl get*)",
      "Bash(kubectl describe*)",
      "Bash(docker image*)",
      "Bash(docker ps*)",
      "Bash(docker pull*)",
      "Bash(zellij *)",
      "Bash(journalctl*)",
      "Bash(systemctl*)",
      "Bash(systemd-analyze*)",
      "Bash(sudo apt install*)",
      "Bash(curl *)",
      "WebFetch",
      "WebSearch"
    ],
    "defaultMode": "acceptEdits"
  },
  "model": "claude-sonnet-4-6",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$ZELLIJ_PANE_ID\" ] && zellij pipe --name \"zellij-attention::waiting::$ZELLIJ_PANE_ID\" || true"
          },
          {
            "type": "command",
            "command": "notify-send \"Claude Code: ${ZELLIJ_SESSION_NAME:-$(basename $PWD)}\" 'Waiting for input' -i dialog-information"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/jreuben1/.config/zellij/plugins/zellaude-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$ZELLIJ_PANE_ID\" ] && zellij pipe --name \"zellij-attention::completed::$ZELLIJ_PANE_ID\" || true"
          },
          {
            "type": "command",
            "command": "notify-send \"Claude Code: ${ZELLIJ_SESSION_NAME:-$(basename $PWD)}\" 'Task complete' -i dialog-information"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/jreuben1/.config/zellij/plugins/zellaude-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/jreuben1/.config/zellij/plugins/zellaude-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/jreuben1/.config/zellij/plugins/zellaude-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/jreuben1/.config/zellij/plugins/zellaude-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/jreuben1/.config/zellij/plugins/zellaude-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/jreuben1/.config/zellij/plugins/zellaude-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/jreuben1/.config/zellij/plugins/zellaude-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/jreuben1/.config/zellij/plugins/zellaude-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/jreuben1/.config/zellij/plugins/zellaude-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/home/jreuben1/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "session-report@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "claude-api@anthropic-agent-skills": false,
    "typescript-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "huggingface-skills@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "cc-marketplace": {
      "source": {
        "source": "github",
        "repo": "ananddtyagi/cc-marketplace"
      }
    },
    "claude-night-market": {
      "source": {
        "source": "github",
        "repo": "athola/claude-night-market"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "ultracode": true,
  "autoCompactWindow": 180000,
  "advisorModel": "opus",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "vim",
  "autoCompactEnabled": true,
  "autoScrollEnabled": true,
  "fileCheckpointingEnabled": true,
  "showTurnDuration": true,
  "todoFeatureEnabled": true,
  "teammateMode": "in-process",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/jreuben1"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "hyprmcp": {
      "command": "/home/jreuben1/.local/share/hyprmcp/run-hyprmcp.sh",
      "args": [],
      "env": {
        "PYTHONPATH": "/home/jreuben1/.local/share/hyprmcp"
      }
    }
  }
}
