{
	"servers": {
		"github": {
			"url": "https://api.githubcopilot.com/mcp/",
			"type": "http"
		},
		"figma": {
			"url": "http://127.0.0.1:3845/mcp",
			"type": "http"
		},
		"playwright": {
			"command": "npx",
			"args": [
				"@playwright/mcp@latest"
			],
			"type": "stdio"
		},
		"huggingface": {
			"url": "https://hf.co/mcp",
			"type": "http"
		},
		"deepwiki": {
			"url": "https://mcp.deepwiki.com/sse",
			"type": "http"
		},
		"markitdown": {
			"command": "uvx",
			"args": [
				"markitdown-mcp"
			],
			"type": "stdio"
		},
		"context7": {
			"command": "npx",
			"args": [
				"-y",
				"@upstash/context7-mcp@latest"
			],
			"type": "stdio"
		},
		"imagesorcery": {
			"command": "uvx",
			"args": [
				"imagesorcery-mcp"
			],
			"type": "stdio"
		},
		"codacy": {
			"command": "npx",
			"args": [
				"-y",
				"@codacy/codacy-mcp"
			],
			"env": {
				"CODACY_ACCOUNT_TOKEN": "${input:codacy_account_token}"
			}
		}
	},
	"inputs": [
		{
			"id": "codacy_account_token",
			"type": "promptString",
			"description": "Codacy Account Token for API access",
			"password": true
		}
	]
}